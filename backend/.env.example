# FlowerConnect Backend Configuration
APP_NAME=FlowerConnect
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=flowerconnect-super-secure-production-secret-key-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=flowerconnect
POSTGRES_PASSWORD=flowerconnect_password
POSTGRES_DB=flowerconnect_db
DATABASE_URL=postgresql+asyncpg://flowerconnect:flowerconnect_password@localhost:5432/flowerconnect_db
# For SQLite local fallback / testing without Postgres:
# DATABASE_URL=sqlite+aiosqlite:///./flowerconnect.db

# Dynamic Price Quotation Configuration
DEFAULT_RFQ_RADIUS_KM=5.0
DEFAULT_RFQ_EXPIRY_MINUTES=45
DEFAULT_QUOTATION_LOCK_MINUTES=30
MIN_QUOTATIONS_FOR_LOCK=1

# Platform Business Model
DEFAULT_PLATFORM_COMMISSION_PERCENT=10.0
DEFAULT_DELIVERY_BASE_FEE=40.0
DELIVERY_PARTNER_SHARE_PERCENT=80.0

# External Integration Keys
FIREBASE_CREDENTIALS_PATH=
GOOGLE_MAPS_API_KEY=
CLOUDINARY_URL=

